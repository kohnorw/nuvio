# Copy to .env and fill in. One file for the whole thing.

# ---- IPTV panel ------------------------------------------------------------
# The only panel this server will talk to.
XTREAM_URL=https://tv.kohnor.ca

# A login baked in for yourself (optional). Leave blank when every user gets
# their own link from the admin page.
XTREAM_USERNAME=
XTREAM_PASSWORD=
# Stream format: ts (works almost everywhere) or m3u8
XTREAM_OUTPUT=ts

# ---- Public address --------------------------------------------------------
# What players connect to. Manifest links and tile images are built from it,
# so it must be reachable from outside.
PUBLIC_URL=https://redirect.kohnor.ca
# Optional: override the shared Live TV manifest link.
# Defaults to <PUBLIC_URL>/manifest.json when left empty.
LIVETV_URL=

# ---- Secrets ---------------------------------------------------------------
# Encrypts each user's login inside their manifest link, so the password is not
# readable in the URL or in proxy logs. Generate with: openssl rand -hex 32
# Changing it invalidates every link already issued, so set it once.
CONFIG_SECRET=

# Turns on POST /api/manifest for issuing links from outside this server.
# The admin page does NOT need it — it calls the addon in-process.
# Leave blank unless you want that endpoint.
API_KEY=

# ---- Admin page ------------------------------------------------------------
# Your AIOStreams builds, offered as the quality choice.
AIOSTREAMS_4K_URL=
AIOSTREAMS_1080P_URL=
LIVETV_COLLECTION_TITLE=Live TV

# ---- Layout ----------------------------------------------------------------
# Collection-only: the addon adds no rows of its own; the Live TV collection
# (one row of category tiles, each opening a grid) is the whole interface.
COLLECTION_ONLY=true

# Let channels turn up in the player's search. Adds no row: the catalog behind
# it cannot be browsed into, only searched.
SEARCHABLE=true
SEARCH_CATALOG_NAME=Live TV channels

# Diagnostic only. Points every category tile at this image instead of the
# generated artwork, to tell a bad image apart from a bad folder object.
# Leave blank in normal use.
TILE_TEST_URL=

# How often to reload the playlist, in hours. Runs on a timer, so changes at
# the provider show up without anyone having to open the app first.
REFRESH_HOURS=3

# How long a logo may take before the channel's initials are served instead.
# Stops one slow logo host leaving a whole grid blank. 0 waits indefinitely.
LOGO_DEADLINE_MS=1500

# One log line per request (status, ms, path, client), with the token redacted.
# Useful for finding out what a misbehaving device actually asks for.
ACCESS_LOG=true

# When the provider renames or renumbers channels, move entries in each
# pushed profile's Nuvio library and Continue Watching onto the new ids. Keeps
# each pushed account's Nuvio session (encrypted with CONFIG_SECRET) in
# CACHE_DIR. false = keep no sessions; old ids still resolve in the addon.
LIBRARY_SYNC=true

# Channels per catalog page. Smaller pages appear sooner on slower devices.
PAGE_SIZE=50

# Last part of the addon's manifest id. Pushed collections point at it, so
# leave it alone unless you want a second, separate addon — and re-push if you
# do change it.
ADDON_ID=main

# ---- Filtering -------------------------------------------------------------
EXCLUDE_GROUPS=adult,xxx,ppv
INCLUDE_GROUPS=

TZ=America/Edmonton
